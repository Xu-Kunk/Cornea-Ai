# Cornea-Ai reproducibility environment (see README.md)
#
# Root of the full project tree (training data, artifacts, checkpoints).
# Python analysis scripts resolve paths relative to the repository;
# shell pipelines require this variable.
CORNEAL_FM_DATA=/path/to/project/root

# Optional: Hugging Face cache directory (defaults to $HOME/.cache/huggingface)
HF_HOME=

# Optional: MinerU API token (used by scripts/mineru_batch_convert.py; key was
# redacted from the repository per the release security scan)
MINERU_TOKEN=
