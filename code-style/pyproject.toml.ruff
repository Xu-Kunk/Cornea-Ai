# ruff 配置片段（对齐 PEP8 + black 88 行宽）
# 用法：合并到项目 pyproject.toml 的 [tool.ruff] 段；或复制为 ruff.toml
# 参考：https://peps.python.org/pep-0008/ | https://docs.astral.sh/ruff/

[tool.ruff]
# 88 = black 默认（PEP8 79 的 110%），团队可改为 79/100
line-length = 88
target-version = "py312"
# 分析范围（按项目调整：src 包 + scripts + tests）
src = ["src", "scripts", "tests"]

[tool.ruff.lint]
# E/F: pycodestyle+pyflakes | I: isort 导入排序 | N: pep8-naming | W: 空白
# UP: pyupgrade | B: bugbear | SIM: 简化 | C4: 可迭代展开
# S: bandit 安全 | RUF: ruff 专属（0.16 起已入默认）| PD: pandas-vet | NPY: NumPy 2.0 兼容
# ANN: 类型注解 | D: pydocstyle | TCH+FA: 仅类型导入 | DTZ: 时区
# ICN: 导入别名(np/pd/plt) | PTH: pathlib | C90: 圈复杂度 | ERA: 注释掉的代码 | INP: src-layout 隐式命名空间
select = ["E", "F", "I", "N", "W", "UP", "B", "SIM", "C4", "S", "RUF", "PD", "NPY", "ANN", "D", "TCH", "FA", "DTZ", "ICN", "PTH", "C90", "ERA", "INP"]
# E203 与 black/ruff-format 的切片空格规则冲突，必须忽略
# S101(assert) 与 ANN401(裸 Any) 在科研代码中过于严格，故忽略
ignore = ["E203", "S101", "ANN401"]

[tool.ruff.lint.isort]
# 项目自身包名（防误判为第三方）
known-first-party = ["src"]

[tool.ruff.lint.pydocstyle]
# NumPy 风格 docstring（Parameters/Returns/Raises）是科学计算事实标准
convention = "numpy"

[tool.ruff.format]
# black 兼容：双引号、空格缩进
quote-style = "double"
indent-style = "space"

# ── 提交前运行 ─────────────────────────────
# ruff check .          # lint
# ruff check . --fix    # 自动修复
# ruff format .         # 格式化
# ruff format --check . # 仅检查
# 注：ruff 0.16.0（2026-07-23）起默认规则扩至 413 条，且默认格式化 Markdown 中的 Python 代码块；
#     显式 select 时需留意不要窄于默认。
